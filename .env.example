# Copy to .env and fill in only what you have. Never commit .env.
# Phase 1 needs NO keys (everything runs locally on CPU).
# From Phase 2 on, shared/llm.ts picks the first provider that has a key,
# in the order of LLM_PROVIDER, or this default order:
#   google -> groq -> openrouter -> anthropic -> openai -> ollama -> mock

# Which provider to prefer: google | groq | openrouter | anthropic | openai | ollama | mock
LLM_PROVIDER=

# FREE tiers (no credit card at time of writing; limits change, check the provider console)
GOOGLE_GENERATIVE_AI_API_KEY=      # https://aistudio.google.com/apikey
GROQ_API_KEY=                      # https://console.groq.com/keys   (also set LLM_MODEL: catalogues change weekly)
OPENROUTER_API_KEY=                # https://openrouter.ai/settings/keys (set LLM_MODEL to a ':free' model id)

# PAID (pay-as-you-go; a Claude.ai / ChatGPT subscription does NOT include API usage)
ANTHROPIC_API_KEY=                 # https://platform.claude.com/settings/keys
OPENAI_API_KEY=                    # https://platform.openai.com/api-keys

# LOCAL (Phase 6)
OLLAMA_BASE_URL=http://localhost:11434

# Optional per-provider model overrides (otherwise shared/llm.ts defaults are used)
LLM_MODEL=
# Client-side pacing in requests/minute (0 = off). Defaults to 14 for Gemini (free tier: 15/min for flash-lite).
LLM_RPM=

# Postgres + pgvector (Phase 3+): npm run db:up
DATABASE_URL=postgres://app:app@localhost:5433/rag
DATABASE_URL_TEST=postgres://app:app@localhost:5433/rag_test

# Phase 5 (MCP project). Generate random values; never commit real ones.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ACME_STATE_KEY=                    # ≥ 32 chars: signs the refund-approval round trip
ACME_MCP_TOKENS=                   # JSON: {"<token>":{"clientId":"sre-oncall","scopes":["ops:read","ops:deploy","tickets:write","billing:refund"]}}
ACME_MCP_TOKEN=                    # the token the agent CLI (npm run agent) sends
ACME_MCP_URL=http://localhost:3050/mcp
